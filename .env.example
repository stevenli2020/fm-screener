# FinancialMarket-owned FastAPI data server. Do not commit credentials to this file.
FM_DATA_SERVER_BASE_URL=http://127.0.0.1:8766
FM_DATA_SERVER_HOST=127.0.0.1
FM_DATA_SERVER_PORT=8766
FM_DATA_SERVER_CACHE_DIR=data/cache/market_data
FM_DATA_SERVER_TIMEOUT_SECONDS=15
FM_DATA_SERVER_MAX_RETRIES=2
FM_DATA_SERVER_RETRY_BACKOFF_SECONDS=0.25
FM_DATA_SERVER_CACHE_TTL_SECONDS=60
FM_DATABASE_PATH=data/financial_market.sqlite3
FM_RISK_RULES_PATH=config/risk_rules_sgx.json
FM_UNIVERSE_PATH=config/universe_sgx.csv
FM_SCREENING_ELIGIBILITY_PATH=config/screening_eligibility_sgx.json
FM_SGX_NEWS_API_URL=https://www.sgx.com/stock-exchange/company-announcements
FM_SGX_NEWS_TIMEOUT_SECONDS=15
FM_SGX_NEWS_MAX_RETRIES=2
FM_SGX_NEWS_RETRY_BACKOFF_SECONDS=0.25
FM_SGX_NEWS_LIMIT=50
FM_SGX_ANNOUNCEMENT_FILTERS_PATH=scripts/sgx_announcement_filters.json
FM_SGX_NEWS_MAX_PAGES_PER_TARGET=10
FM_SGX_NEWS_REQUEST_PACING_SECONDS=0.5
